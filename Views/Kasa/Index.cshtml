@model IEnumerable<SmartMenu.Models.Siparis>
@{
    ViewData["Title"] = "Kasa";
    var culture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="bg-surface-container-lowest p-4 sm:p-6 lg:p-8 rounded-card shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-surface-container max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h2 class="text-2xl font-bold text-on-surface">Kasa</h2>
            <p class="text-[12px] text-on-surface-variant mt-1">Tamamlanan siparişleri tahsilat durumuna göre yönetin</p>
        </div>
        <a href="/Siparisler" class="inline-flex items-center gap-2 rounded-xl bg-blue-50 px-4 py-2.5 text-sm font-bold text-blue-700 hover:bg-blue-100">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            Siparişlere Dön
        </a>
    </div>

    <div class="space-y-4">
        @if (Model != null && Model.Any())
        {
            foreach (var siparis in Model)
            {
                var odendi = siparis.Durum == "Odendi";
                var detailsId = $"kasa-detay-{siparis.Id}";

                <article class="rounded-2xl border border-surface-container bg-white p-4 shadow-sm @(odendi ? "opacity-60" : "")">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant">Masa</p>
                            <h3 class="font-extrabold text-on-surface @(odendi ? "text-xl line-through" : "text-2xl")">@siparis.MasaNo</h3>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <span class="text-sm font-bold text-on-surface">Sipariş #@siparis.Id</span>
                                <span class="rounded-full px-3 py-1 text-[12px] font-bold @(odendi ? "bg-gray-100 text-gray-600" : "bg-green-50 text-green-700")">
                                    @(odendi ? "Ödendi" : "Tahsilat Bekliyor")
                                </span>
                            </div>
                            <p class="mt-1 text-[13px] text-on-surface-variant">
                                @(siparis.Sube?.SubeAdi ?? "Şube") · @siparis.SiparisTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </p>
                        </div>

                        <div class="text-left sm:text-right">
                            <p class="text-[12px] font-bold uppercase tracking-wider text-on-surface-variant">Toplam</p>
                            <p class="text-2xl font-extrabold text-primary">@siparis.ToplamTutar.ToString("C", culture)</p>
                        </div>
                    </div>

                    <button type="button"
                            class="toggle-details mt-4 inline-flex items-center gap-2 rounded-xl bg-surface-container px-4 py-2 text-sm font-bold text-on-surface hover:bg-gray-200"
                            data-target="@detailsId">
                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                        Detayları Gör
                    </button>

                    <div id="@detailsId" class="hidden mt-4 divide-y divide-surface-container rounded-xl bg-surface-container-lowest">
                        @foreach (var detay in siparis.Detaylar)
                        {
                            <div class="flex items-center justify-between gap-3 px-4 py-3">
                                <div>
                                    <p class="text-sm font-bold text-on-surface">@detay.Urun?.Ad</p>
                                    <p class="text-xs text-on-surface-variant">@detay.Adet adet x @detay.BirimFiyat.ToString("C", culture)</p>
                                </div>
                                <p class="text-sm font-bold text-on-surface">@((detay.Adet * detay.BirimFiyat).ToString("C", culture))</p>
                            </div>
                        }
                    </div>

                    <div class="mt-4 flex flex-wrap justify-end gap-2">
                        @if (!odendi)
                        {
                            <form asp-action="OdendiYap" method="post" class="m-0">
                                <input type="hidden" name="id" value="@siparis.Id" />
                                <button type="submit" class="rounded-xl bg-green-600 px-4 py-2 text-sm font-bold text-white hover:bg-green-700">Ödendi Olarak İşaretle</button>
                            </form>
                        }

                        <form asp-action="Sil" method="post" class="m-0 secure-delete-form" data-message="Bu sipariş veritabanından kalıcı olarak silinecek.">
                            <input type="hidden" name="id" value="@siparis.Id" />
                            <input type="hidden" name="sifre" value="" />
                            <button type="submit" class="rounded-xl bg-red-50 px-4 py-2 text-sm font-bold text-red-700 hover:bg-red-100">Kalıcı Sil</button>
                        </form>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="text-center py-14 px-6 bg-surface-container-lowest border border-dashed border-outline-variant rounded-2xl">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-green-50 text-green-700">
                    <span class="material-symbols-outlined text-4xl">point_of_sale</span>
                </div>
                <h3 class="text-lg font-bold text-on-surface">Kasada bekleyen sipariş yok</h3>
                <p class="mt-2 text-sm text-on-surface-variant">Tamamlanan siparişler burada tahsilat için listelenecek.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Kasa kartlarında ürün detayları kalabalık yapmasın diye varsayılan kapalı gelir.
        document.querySelectorAll('.toggle-details').forEach(function (button) {
            button.addEventListener('click', function () {
                const target = document.getElementById(button.dataset.target);
                if (!target) return;

                target.classList.toggle('hidden');
                button.querySelector('.material-symbols-outlined').textContent = target.classList.contains('hidden') ? 'visibility' : 'visibility_off';
                button.lastChild.textContent = target.classList.contains('hidden') ? ' Detayları Gör' : ' Detayları Gizle';
            });
        });

        // Kasa silme işlemi daha hassas olduğu için SweetAlert içinde yönetici şifresi istiyoruz.
        document.querySelectorAll('.secure-delete-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();

                Swal.fire({
                    title: 'Yönetici Şifresi',
                    text: form.dataset.message || 'Bu işlem geri alınamaz.',
                    input: 'password',
                    inputPlaceholder: 'Şifrenizi girin',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sil',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#ba1a1a',
                    cancelButtonColor: '#6b7280',
                    reverseButtons: true,
                    customClass: {
                        popup: 'rounded-2xl',
                        confirmButton: 'rounded-xl',
                        cancelButton: 'rounded-xl',
                        input: 'rounded-xl'
                    },
                    inputValidator: function (value) {
                        if (!value) {
                            return 'Silmek için yönetici şifresini yazmalısınız.';
                        }
                    }
                }).then(function (result) {
                    if (result.isConfirmed) {
                        form.querySelector('input[name="sifre"]').value = result.value;
                        form.submit();
                    }
                });
            });
        });
    </script>
}
