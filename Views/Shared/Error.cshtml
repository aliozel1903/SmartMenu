@model ErrorViewModel
@{
    // Hata sayfası paneli değil sade hesap şablonunu kullanır: hata giriş yapmamış bir ziyaretçide de
    // oluşabilir ve hata anında panelin veritabanı sorgularını tekrar çalıştırmak istemeyiz.
    Layout = "~/Views/Account/_HesapLayout.cshtml";
    ViewData["Title"] = "Bir Hata Oluştu";
    ViewData["Baslik"] = "Bir şeyler ters gitti";
    ViewData["AltBaslik"] = "İsteğiniz işlenirken beklenmeyen bir hata oluştu.";
}

<p class="text-[15px] text-gray-600 leading-6 mb-6">
    Sorun büyük ihtimalle geçicidir. Birkaç saniye sonra sayfayı yenileyin ya da ana sayfadan devam edin.
</p>

<a asp-controller="Home" asp-action="Index" class="block w-full py-3.5 text-center bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all">
    Ana Sayfaya Dön
</a>

@* Kayıtlarda (log) bu hatayı bulmak için kullanılan kimlik. Hatanın ayrıntısını göstermez. *@
@if (Model.ShowRequestId)
{
    <p class="mt-6 text-center text-[12px] text-gray-400 break-all">Hata kodu: @Model.RequestId</p>
}
