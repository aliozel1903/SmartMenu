@{
    Layout = null; 
    var searchItemsJson = Json.Serialize(ViewBag.SearchItems ?? new List<object>());
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartMenu - Dijital Menü Platformu</title>
    <link rel="icon" type="image/png" href="~/img/smartmenu-logo.png" />
    <link rel="apple-touch-icon" href="~/img/smartmenu-logo.png" />
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700" rel="stylesheet" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }

        /* Ana sayfanın beyaz/boş görünmemesi için çok hafif bir QR-grid arka plan dokusu ekliyoruz. */
        .qr-pattern {
            background-image:
                linear-gradient(rgba(37, 99, 235, 0.08) 1px, transparent 1px),
                linear-gradient(90deg, rgba(37, 99, 235, 0.08) 1px, transparent 1px);
            background-size: 34px 34px;
            /* Desen aşağı doğru kaybolsun; içerik alanında göz yormasın. */
            mask-image: linear-gradient(to bottom, black, transparent 72%);
        }
    </style>
</head>
<body class="relative bg-[#FDFCF8] text-[#181512]">

    <!-- Arka plan katmanı: sayfanın üstünde hafif QR-grid hissi verir, tıklamaları engellemez. -->
    <div class="qr-pattern pointer-events-none absolute inset-x-0 top-0 h-[520px]"></div>

    <!-- Büyük ve silik logo watermark: marka hissi verir ama ana metnin önüne geçmez. -->
    <div class="pointer-events-none absolute right-[-120px] top-24 hidden md:block opacity-[0.08]">
        <img src="~/img/smartmenu-logo.png" alt="" class="w-[420px] h-[420px] object-contain" />
    </div>

    <nav class="relative z-10 flex flex-col md:flex-row justify-between items-center px-4 py-6 md:px-6 max-w-7xl mx-auto w-full gap-4 md:gap-0">
        <div class="flex items-center gap-3">
            <img src="~/img/smartmenu-logo.png" alt="SmartMenu" class="w-11 h-11 rounded-2xl object-cover shadow-sm" />
            <div class="text-2xl font-extrabold tracking-tighter text-blue-600">Smart<span class="text-stone-800">Menu</span></div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Account" asp-action="Login" class="px-4 py-2 text-sm font-bold text-stone-600 hover:text-blue-600 transition-colors">Giriş Yap</a>
            <a asp-controller="Account" asp-action="Register" class="px-5 py-2.5 text-sm font-bold bg-blue-600 text-white rounded-full shadow-md hover:bg-blue-700 transition-all active:scale-95">Ücretsiz Başla</a>
        </div>
    </nav>

    <main class="relative z-10 max-w-4xl mx-auto px-4 pt-8 md:pt-12 pb-16 md:pb-24 text-center">
        <h1 class="text-4xl md:text-7xl font-extrabold tracking-tight mb-6 md:mb-8">
            Lezzeti <span class="text-blue-600 italic">Dijitalle</span> Buluşturun.
        </h1>
        <p class="text-base md:text-lg text-stone-500 mb-10 max-w-2xl mx-auto leading-relaxed font-medium px-2">
            Müşterileriniz QR kodunuzu okutsun, menünüze anında ulaşsın. Saniyeler içinde kendi dijital menünüzü oluşturun.
        </p>

        <div class="relative bg-white/95 backdrop-blur p-2 rounded-[24px] md:rounded-[32px] shadow-[0_10px_30px_rgba(0,0,0,0.05)] border border-stone-100 flex flex-col md:flex-row gap-2 max-w-2xl mx-auto mb-12">
            <div class="relative flex-grow w-full">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-stone-400 leading-none pointer-events-none">search</span>
                <input id="cafeSearchInput" type="text" placeholder="Kafe veya Restoran Ara..." class="w-full bg-stone-50 py-4 pl-12 pr-4 rounded-[18px] md:rounded-[24px] outline-none border-none text-[15px] font-semibold focus:ring-2 focus:ring-blue-600/20 transition-all" />
            </div>
            <button onclick="goToCafe()" class="w-full md:w-auto bg-[#181512] text-white px-8 py-4 rounded-[18px] md:rounded-[24px] font-bold hover:bg-stone-800 transition-all flex items-center justify-center gap-2">
                Menüyü Gör <span class="material-symbols-outlined">arrow_forward</span>
            </button>

            <!-- Arama önerileri buraya JS ile basılır. -->
            <div id="searchSuggestions" class="hidden absolute left-2 right-2 top-[76px] md:top-[72px] z-30 overflow-hidden rounded-2xl border border-stone-100 bg-white text-left shadow-[0_18px_50px_rgba(0,0,0,0.10)]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            <div class="p-6 md:p-8 bg-blue-50 rounded-[24px] md:rounded-[32px] text-left border border-blue-100 group hover:bg-blue-600 transition-all duration-300 cursor-pointer">
                <span class="material-symbols-outlined text-4xl text-blue-600 group-hover:text-white mb-3 md:mb-4">qr_code_scanner</span>
                <h3 class="text-lg md:text-xl font-bold mb-2 group-hover:text-white">QR Okut</h3>
                <p class="text-xs md:text-sm text-blue-800 group-hover:text-blue-100">Kameranı aç ve masadaki kodu tara.</p>
            </div>
            <div class="p-6 md:p-8 bg-stone-50 rounded-[24px] md:rounded-[32px] text-left border border-stone-100">
                <span class="material-symbols-outlined text-4xl text-stone-500 mb-3 md:mb-4">restaurant</span>
                <h3 class="text-lg md:text-xl font-bold mb-2">Popüler Mekanlar</h3>
                <p class="text-xs md:text-sm text-stone-500">Şehrindeki en iyi dijital menüleri keşfet.</p>
            </div>
            <div class="p-6 md:p-8 bg-stone-50 rounded-[24px] md:rounded-[32px] text-left border border-stone-100">
                <span class="material-symbols-outlined text-4xl text-stone-500 mb-3 md:mb-4">bolt</span>
                <h3 class="text-lg md:text-xl font-bold mb-2">Hızlı Sipariş</h3>
                <p class="text-xs md:text-sm text-stone-500">Bekleme yapmadan, doğrudan telefondan seç.</p>
            </div>
        </div>
    </main>

    <script>
        // Controller'dan gelen şube listesiyle ana sayfa aramasını gerçek önerilere bağlıyoruz.
        const searchItems = @Html.Raw(searchItemsJson);
        const searchInput = document.getElementById('cafeSearchInput');
        const suggestionsBox = document.getElementById('searchSuggestions');
        let selectedToken = null;

        function normalizeSearchText(value) {
            return (value || '').toLocaleLowerCase('tr-TR');
        }

        function renderSuggestions(query) {
            const normalizedQuery = normalizeSearchText(query);
            suggestionsBox.innerHTML = '';

            if (!normalizedQuery) {
                suggestionsBox.classList.add('hidden');
                selectedToken = null;
                return;
            }

            const matches = searchItems
                .filter(item => normalizeSearchText(`${item.markaAdi} ${item.subeAdi} ${item.adres}`).includes(normalizedQuery))
                .slice(0, 6);

            if (matches.length === 0) {
                suggestionsBox.classList.add('hidden');
                selectedToken = null;
                return;
            }

            matches.forEach(item => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full px-4 py-3 hover:bg-blue-50 transition-colors flex items-center gap-3 text-left';
                button.innerHTML = `
                    <span class="material-symbols-outlined text-blue-600">storefront</span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-stone-900 truncate">${item.subeAdi || item.markaAdi}</span>
                        <span class="block text-xs text-stone-500 truncate">${item.markaAdi || 'SmartMenu'}${item.adres ? ' · ' + item.adres : ''}</span>
                    </span>
                `;
                button.addEventListener('click', function () {
                    selectedToken = item.token;
                    searchInput.value = item.subeAdi || item.markaAdi;
                    suggestionsBox.classList.add('hidden');
                });
                suggestionsBox.appendChild(button);
            });

            suggestionsBox.classList.remove('hidden');
        }

        searchInput.addEventListener('input', function () {
            renderSuggestions(this.value);
        });

        function goToCafe() {
            const val = searchInput.value;
            if (!selectedToken && val) {
                const normalizedValue = normalizeSearchText(val);
                const firstMatch = searchItems.find(item => normalizeSearchText(`${item.markaAdi} ${item.subeAdi}`).includes(normalizedValue));
                selectedToken = firstMatch?.token || null;
            }

            if (selectedToken) {
                window.location.href = "/Menu?token=" + encodeURIComponent(selectedToken);
                return;
            }

            alert("Lütfen listeden bir kafe veya şube seçin.");
        }
    </script>
</body>
</html>
