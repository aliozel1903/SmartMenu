@model SmartMenu.Models.Urun
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-4 mb-6 mt-2">
        <a asp-action="Index" class="w-10 h-10 bg-surface-container-lowest border border-surface-container rounded-full flex items-center justify-center text-on-surface-variant hover:bg-gray-50 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>
        <div>
            <h2 class="text-2xl font-bold text-on-surface">Yeni Ürün Ekle</h2>
            <p class="text-[13px] text-on-surface-variant">Menünüze yeni bir lezzet katın</p>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-6 lg:p-8 rounded-card shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-surface-container">
        
        <form id="urunForm" asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-error text-sm mb-4 p-4 bg-red-50 rounded-xl empty:hidden"></div>
            
            <div class="mb-6">
                <label class="block text-[13px] font-semibold text-on-surface-variant mb-2">Ürün Fotoğrafı</label>
                
                <div id="dropZone" class="relative border-2 border-dashed border-outline-variant hover:border-primary transition-colors rounded-2xl p-8 text-center bg-gray-50/50 cursor-pointer overflow-hidden group">
                    <img id="previewImage" class="absolute inset-0 w-full h-full object-cover hidden" />
                    <div id="uploadPlaceholder" class="relative z-10 group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-4xl text-gray-400 group-hover:text-primary transition-colors mb-2">add_photo_alternate</span>
                        <p class="text-[14px] font-medium text-gray-500 group-hover:text-primary transition-colors">Seç veya Sürükle (Otomatik Kırpılır)</p>
                    </div>
                </div>

                <input type="file" id="imageInput" accept="image/*" class="hidden" />
                <input type="file" id="finalImageInput" name="resim" class="hidden" />
            </div>

            <div class="space-y-6">
                <div>
                    <label asp-for="Ad" class="block text-[13px] font-semibold text-on-surface-variant mb-2">Ürün Adı</label>
                    <input asp-for="Ad" class="w-full bg-surface-container py-3 px-4 rounded-xl border border-transparent focus:bg-surface-container-lowest focus:border-primary focus:ring-4 focus:ring-primary/10 text-[15px] outline-none transition-all" placeholder="Örn: Karışık Pizza" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="KategoriId" class="block text-[13px] font-semibold text-on-surface-variant mb-2">Kategori</label>
                        <div class="relative">
                            <select asp-for="KategoriId" style="background-image: none;" class="w-full bg-surface-container py-3 px-4 pr-10 rounded-xl border border-transparent focus:bg-surface-container-lowest focus:border-primary focus:ring-4 focus:ring-primary/10 text-[15px] outline-none transition-all appearance-none cursor-pointer" asp-items="ViewBag.KategoriId">
                                <option value="">-- Kategori Seçiniz --</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Fiyat" class="block text-[13px] font-semibold text-on-surface-variant mb-2">Fiyat</label>
                        <div class="relative flex items-center">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <span class="text-on-surface-variant font-semibold">₺</span>
                            </div>
                            <input asp-for="Fiyat" type="text" class="w-full bg-surface-container py-3 pl-9 pr-4 rounded-xl border border-transparent focus:bg-surface-container-lowest focus:border-primary focus:ring-4 focus:ring-primary/10 text-[15px] outline-none transition-all" placeholder="0,00" oninput="this.value = this.value.replace('.', ',');" />
                        </div>
                    </div>
                </div>

                <div>
                    <label asp-for="Icerik" class="block text-[13px] font-semibold text-on-surface-variant mb-2">Açıklama</label>
                    <textarea asp-for="Icerik" rows="3" class="w-full bg-surface-container py-3 px-4 rounded-xl border border-transparent focus:bg-surface-container-lowest focus:border-primary focus:ring-4 focus:ring-primary/10 text-[15px] outline-none transition-all resize-none"></textarea>
                </div>

                <div class="flex items-center justify-between gap-4 rounded-2xl bg-surface-container p-4">
                    <div>
                        <label asp-for="AktifMi" class="block text-[13px] font-semibold text-on-surface">Menüde Gösterilsin mi?</label>
                        <p class="text-[12px] text-on-surface-variant mt-1">Pasif yaparsanız ürün müşteri menüsünde görünmez.</p>
                    </div>

                    <label class="relative inline-flex cursor-pointer items-center">
                        <input asp-for="AktifMi" type="checkbox" class="peer sr-only" />
                        <div class="h-7 w-12 rounded-full bg-outline-variant transition-colors peer-checked:bg-primary"></div>
                        <div class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow-md transition-transform peer-checked:translate-x-5"></div>
                    </label>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 mt-8 pt-6 border-t border-surface-container">
                <a asp-action="Index" class="px-5 py-2.5 text-on-surface-variant hover:bg-surface-container font-semibold rounded-xl transition-colors">İptal Et</a>
                <button type="submit" class="bg-primary text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors shadow-md active:scale-95 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">save</span> Ürünü Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<div id="cropperModal" class="fixed inset-0 z-[60] bg-black/80 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-surface-container-lowest p-6 rounded-2xl max-w-lg w-full shadow-2xl">
        <h3 class="text-lg font-bold mb-4 text-on-surface">Fotoğrafı Ayarla</h3>
        <div class="w-full h-[300px] bg-gray-100 rounded-xl overflow-hidden mb-4 relative">
            <img id="imageToCrop" class="max-w-full block" />
        </div>
        <p class="text-xs text-on-surface-variant mb-4 text-center">İdeal menü görünümü için fotoğrafı 1:1 (Kare) formatında ayarlayın.</p>
        <div class="flex justify-end gap-3">
            <button type="button" id="cancelCropBtn" class="px-4 py-2 text-on-surface-variant font-semibold hover:bg-gray-100 rounded-xl transition-colors">Vazgeç</button>
            <button type="button" id="saveCropBtn" class="px-5 py-2 bg-primary text-white font-semibold rounded-xl shadow-md hover:bg-blue-700 transition-all">Kırp ve Onayla</button>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        if ($.validator) {
            $.validator.methods.number = function (value, element) {
                // Virgülü noktaya çevirip arka plandaki İngiliz sisteme "Al sana geçerli sayı" diyoruz
                var val = value.replace(",", ".");
                return this.optional(element) || !isNaN(val);
            };
            
            $.validator.methods.range = function (value, element, param) {
                var val = value.replace(",", ".");
                return this.optional(element) || (val >= param[0] && val <= param[1]);
            };
        }
    </script>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropZone = document.getElementById('dropZone');
            const imageInput = document.getElementById('imageInput');
            const finalImageInput = document.getElementById('finalImageInput');
            const cropperModal = document.getElementById('cropperModal');
            const imageToCrop = document.getElementById('imageToCrop');
            const previewImage = document.getElementById('previewImage');
            const uploadPlaceholder = document.getElementById('uploadPlaceholder');
            const cancelCropBtn = document.getElementById('cancelCropBtn');
            const saveCropBtn = document.getElementById('saveCropBtn');
            
            let cropper = null;

            // Kutuya tıklayınca dosya seçiciyi aç
            dropZone.addEventListener('click', () => imageInput.click());

            // Dosya seçildiğinde
            imageInput.addEventListener('change', function (e) {
                const files = e.target.files;
                if (files && files.length > 0) {
                    const file = files[0];
                    // Sadece resim dosyalarını kabul et
                    if (!file.type.startsWith('image/')) return;

                    const reader = new FileReader();
                    reader.onload = function (event) {
                        imageToCrop.src = event.target.result;
                        cropperModal.classList.remove('hidden'); // Modalı göster
                        
                        // Eski cropper varsa temizle
                        if (cropper) { cropper.destroy(); }
                        
                        // Yeni cropper'ı başlat (Kesinlikle Kare 1:1 olmasını zorluyoruz)
                        cropper = new Cropper(imageToCrop, {
                            aspectRatio: 1 / 1,
                            viewMode: 2,
                            background: false,
                        });
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Vazgeç Butonu
            cancelCropBtn.addEventListener('click', function () {
                cropperModal.classList.add('hidden');
                imageInput.value = ''; // Seçimi sıfırla
            });

            // Kırp ve Onayla Butonu
            saveCropBtn.addEventListener('click', function () {
                if (!cropper) return;

                // Kırpılan resmi Canvas olarak al (600x600 px boyutuna sabitliyor, performansı artırıyor!)
                cropper.getCroppedCanvas({
                    width: 600,
                    height: 600
                }).toBlob(function (blob) {
                    // Blob'u (Görsel verisini) File objesine çeviriyoruz
                    const file = new File([blob], "kirpilmis_urun.jpg", { type: "image/jpeg", lastModified: new Date().getTime() });
                    
                    // JS ile sahte bir Dosya Listesi (DataTransfer) oluşturup C#'a gidecek input'a ekliyoruz!
                    const container = new DataTransfer();
                    container.items.add(file);
                    finalImageInput.files = container.files;

                    // Önizlemeyi kutuya yerleştir
                    const croppedUrl = URL.createObjectURL(blob);
                    previewImage.src = croppedUrl;
                    previewImage.classList.remove('hidden');
                    uploadPlaceholder.classList.add('hidden'); // İkonu gizle

                    cropperModal.classList.add('hidden'); // Modalı kapat
                }, 'image/jpeg', 0.8); // 0.8 kalite (Boyutu inanılmaz düşürür, kaliteyi bozmaz)
            });
        });
    </script>
}
