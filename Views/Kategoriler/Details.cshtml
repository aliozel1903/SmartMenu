@model SmartMenu.Models.Kategori
@{ 
    ViewData["Title"] = "Kategori Detayları"; 
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-4 mb-6 mt-2">
        <a asp-action="Index" class="w-10 h-10 bg-surface-container-lowest border border-surface-container rounded-full flex items-center justify-center text-on-surface-variant hover:bg-gray-50 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </a>
        <div>
            <h2 class="text-2xl font-bold text-on-surface">Kategori Bilgileri</h2>
            <p class="text-[13px] text-on-surface-variant">Kategorinin sisteme kayıtlı tüm detayları</p>
        </div>
    </div>

    <div class="bg-surface-container-lowest overflow-hidden rounded-card shadow-[0_4px_20px_rgba(0,0,0,0.05)] border border-surface-container">
        <div class="p-8 text-center border-b border-surface-container bg-gray-50/30">
            <div class="w-20 h-20 bg-blue-50 text-primary rounded-3xl flex items-center justify-center mx-auto mb-4 shadow-sm">
                <span class="material-symbols-outlined text-4xl">folder</span>
            </div>
            <h3 class="text-2xl font-bold text-on-surface">@Model.Ad</h3>
            <p class="text-sm text-on-surface-variant mt-1">ID: #@Model.Id</p>
        </div>

        <div class="p-6 space-y-0 text-[15px]">
            <div class="flex justify-between py-4 border-b border-gray-100">
                <span class="text-on-surface-variant font-medium">Bağlı Olduğu Kafe</span>
                <span class="text-on-surface font-semibold">@(Model.Cafe != null ? Model.Cafe.Ad : "Yok")</span>
            </div>
            <div class="flex justify-between py-4 border-b border-gray-100">
                <span class="text-on-surface-variant font-medium">Görünüm Sırası</span>
                <span class="text-on-surface font-semibold">@Model.Sira</span>
            </div>
            <div class="flex justify-between py-4">
                <span class="text-on-surface-variant font-medium">Aktiflik Durumu</span>
                @if(Model.AktifMi) { 
                    <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-[12px] font-bold">Aktif</span> 
                }
                else { 
                    <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-[12px] font-bold">Pasif</span> 
                }
            </div>
        </div>

        <div class="p-6 bg-gray-50/50 flex justify-between items-center border-t border-surface-container">
            <a asp-action="Index" class="text-on-surface-variant hover:text-on-surface font-semibold text-sm transition-colors">Listeye Dön</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-primary text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-blue-700 transition-colors shadow-md flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">edit</span> Düzenle
            </a>
        </div>
    </div>
</div>