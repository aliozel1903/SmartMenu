@{
    Layout = "_HesapLayout";
    ViewData["Title"] = "Giriş Yap";
    ViewData["Baslik"] = "Yönetim Paneli";
    ViewData["AltBaslik"] = "Devam etmek için giriş yapın";

    // Şablon (_HesapLayout) hata ve bilgi kutularını ViewBag'den çizer.
    ViewBag.Bilgi = TempData["Basari"] as string;
    ViewBag.Hata = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<form asp-action="Login" method="post" class="space-y-5">
    <div>
        <label for="email" class="block text-[13px] font-semibold text-gray-600 mb-1.5">E-Posta Adresiniz</label>
        <input id="email" type="email" name="email" required autocomplete="username" placeholder="mail@isletmeniz.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
    </div>

    <div>
        <label for="password" class="block text-[13px] font-semibold text-gray-600 mb-1.5">Şifre</label>
        <div class="relative">
            <input id="password" type="password" name="password" required autocomplete="current-password" placeholder="••••••••" class="w-full pl-4 pr-20 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
            <button type="button" id="sifreGoster" class="absolute right-3 top-1/2 -translate-y-1/2 px-2 py-1 text-[13px] font-semibold text-gray-500 hover:text-blue-600">Göster</button>
        </div>
    </div>

    <div class="flex items-center justify-between">
        <label class="flex items-center gap-2 cursor-pointer text-[14px] text-gray-600">
            <input type="checkbox" name="rememberMe" value="true" class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600" />
            Beni Hatırla
        </label>
        <a asp-action="SifremiUnuttum" class="text-[14px] font-semibold text-blue-600 hover:underline">Şifremi Unuttum</a>
    </div>

    <button type="submit" class="w-full py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg active:scale-[0.98]">
        Giriş Yap
    </button>
</form>

@* Şifresi doğru ama e-postası doğrulanmamış hesaplar için. Adres URL'ye değil gizli form alanına konur. *@
@if (ViewBag.DogrulanmamisEposta is string dogrulanmamisEposta)
{
    <form asp-action="Dogrulama" method="post" class="mt-4">
        <input type="hidden" name="email" value="@dogrulanmamisEposta" />
        <button type="submit" class="w-full py-3 border border-gray-200 rounded-xl text-[14px] font-semibold text-blue-600 hover:bg-gray-50 transition-all">
            Doğrulama Bağlantısını Tekrar Gönder
        </button>
    </form>
}

<div class="text-center mt-6 space-y-2">
    <p class="text-[14px] text-gray-500">Hesabınız yok mu? <a asp-action="Register" class="text-blue-600 font-bold hover:underline">Kayıt Ol</a></p>
    <a asp-controller="Home" asp-action="Index" class="inline-block text-[13px] text-gray-400 hover:text-gray-600">← Ana sayfaya dön</a>
</div>

@section Scripts {
    <script>
        document.getElementById('sifreGoster').addEventListener('click', function () {
            const input = document.getElementById('password');
            const gizli = input.type === 'password';
            input.type = gizli ? 'text' : 'password';
            this.textContent = gizli ? 'Gizle' : 'Göster';
        });
    </script>
}
