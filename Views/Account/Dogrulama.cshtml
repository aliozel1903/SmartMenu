@{
    Layout = "_HesapLayout";
    ViewData["Title"] = "E-posta Doğrulama";
    ViewData["Baslik"] = "Gelen Kutunu Kontrol Et";
    var eposta = ViewBag.Eposta as string;
}

@if (eposta != null)
{
    <p class="text-[15px] text-gray-600 leading-6 mb-6">
        Hesabını etkinleştirmek için <strong class="text-gray-800 break-all">@eposta</strong> adresine bir doğrulama bağlantısı gönderdik.
        Bağlantıya tıkladıktan sonra giriş yapabilirsin. Birkaç dakika içinde gelmezse spam klasörüne de bak.
    </p>
}

<form asp-action="Dogrulama" method="post" class="space-y-4">
    <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">E-posta gelmedi mi? Adresini yaz, yenisini gönderelim.</label>
    <input type="email" name="email" required value="@eposta" placeholder="mail@isletmeniz.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
    <button type="submit" class="w-full py-3.5 bg-gray-800 text-white font-bold rounded-xl hover:bg-gray-900 transition-all active:scale-[0.98]">
        Doğrulama Bağlantısını Tekrar Gönder
    </button>
</form>

<div class="text-center mt-6">
    <a asp-action="Login" class="text-[14px] text-blue-600 font-bold hover:underline">Giriş sayfasına dön</a>
</div>
