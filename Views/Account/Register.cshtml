@{
    Layout = "_HesapLayout";
    ViewData["Title"] = "Kayıt Ol";
    ViewData["Baslik"] = "İşletmenizi Dijitale Taşıyın";
    ViewData["AltBaslik"] = "Saniyeler içinde hesabınızı oluşturun";
}

<form asp-action="Register" method="post" class="space-y-5">
    <div>
        <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">İşletme (Kafe) Adı</label>
        <input type="text" name="cafeName" required maxlength="100" placeholder="Örn: Star Kafe" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
    </div>

    <div>
        <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">E-Posta Adresiniz</label>
        <input type="email" name="email" required maxlength="150" placeholder="mail@isletmeniz.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
        <p class="text-[12px] text-gray-400 mt-1.5 ml-1">Hesabınızı etkinleştirmek için bu adrese bir doğrulama bağlantısı göndereceğiz.</p>
    </div>

    <div>
        <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">Şifre</label>
        <input type="password" name="password" required minlength="8" placeholder="En az 8 karakter" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
    </div>

    <button type="submit" class="w-full py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg active:scale-[0.98] mt-2">
        Hesabımı Oluştur
    </button>
</form>

<div class="text-center mt-6">
    <p class="text-[14px] text-gray-500">Zaten bir hesabınız var mı? <a asp-controller="Account" asp-action="Login" class="text-blue-600 font-bold hover:underline">Giriş Yap</a></p>
</div>
