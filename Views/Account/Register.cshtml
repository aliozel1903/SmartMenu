@{
    Layout = null;
    ViewData["Title"] = "Kayıt Ol";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - SmartMenu</title>
    <link rel="icon" type="image/png" href="~/img/smartmenu-logo.png" />
    <link rel="apple-touch-icon" href="~/img/smartmenu-logo.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #F8F9FA; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">

    <div class="bg-white w-full max-w-md p-8 md:p-10 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100">
        
        <div class="text-center mb-8">
            <h1 class="text-2xl font-extrabold tracking-tighter text-blue-600 mb-2">Smart<span class="text-gray-800">Menu</span></h1>
            <h2 class="text-xl font-bold text-gray-800">İşletmenizi Dijitale Taşıyın</h2>
            <p class="text-sm text-gray-500 mt-1">Saniyeler içinde hesabınızı oluşturun</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-5">
            <div>
                <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">İşletme (Kafe) Adı</label>
                <input type="text" name="cafeName" required placeholder="Örn: Star Kafe" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
            </div>

            <div>
                <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">E-Posta Adresiniz</label>
                <input type="email" name="email" required placeholder="mail@isletmeniz.com" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
            </div>

            <div>
                <label class="block text-[13px] font-semibold text-gray-600 mb-1.5">Şifre</label>
                <input type="password" name="password" required placeholder="••••••••" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-[15px] focus:bg-white focus:border-blue-600 focus:ring-4 focus:ring-blue-600/10 outline-none transition-all" />
            </div>

            <button type="submit" class="w-full py-3.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg active:scale-[0.98] mt-2">
                Hesabımı Oluştur
            </button>
        </form>

        <div class="text-center mt-6">
            <p class="text-[14px] text-gray-500">Zaten bir hesabınız var mı? <a asp-controller="Account" asp-action="Login" class="text-blue-600 font-bold hover:underline">Giriş Yap</a></p>
        </div>
    </div>

</body>
</html>
